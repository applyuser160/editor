{
  "name": "oxide-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:extension-host": "npm --prefix extension-host test",
    "test:watch": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"extension-host/**/*.{mjs,json}\" \"examples/**/*.{js,json}\" \"*.{ts,json,md}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"extension-host/**/*.{mjs,json}\" \"examples/**/*.{js,json}\" \"*.{ts,json,md}\" \".github/**/*.yml\"",
    "check": "npm run format:check && npm run build && npm run test && npm run test:extension-host",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "monaco-editor": "^0.52.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "pyright": "^1.1.413",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.11"
  }
}
